# Copy to .env (never commit .env). Read by `astro dev start`.

# duckdb (local, default) or databricks
DBT_TARGET=duckdb

# --- Databricks mode only ---
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=stock_platform
# Path of the bronze notebook once imported in the workspace
DATABRICKS_BRONZE_NOTEBOOK=/Workspace/Users/you@example.com/stock-data-platform/01_bronze_ingestion
# Airflow connection used by the Databricks operator
AIRFLOW_CONN_DATABRICKS_DEFAULT='{"conn_type": "databricks", "host": "https://dbc-xxxxxxxx-xxxx.cloud.databricks.com", "password": "dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX"}'
